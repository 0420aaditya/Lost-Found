# ---- Lost & Found Hub: server environment ----
# Copy this file to ".env" and adjust the values.
# NEVER commit the real .env file.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/lostfoundhub

# Secret used to sign JWT login tokens.
# Use a long random string. Keep it private.
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# The frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional: where uploaded images are stored (defaults to server/uploads).
# Can be relative to server/ or absolute. Use a persistent volume in production.
# UPLOAD_DIR=uploads

# Optional: set to "true" when running behind a reverse proxy (Nginx/Heroku)
# so Express trusts X-Forwarded-* headers.
# TRUST_PROXY=true
